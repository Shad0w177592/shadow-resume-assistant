{
  "name": "@shadow/desktop",
  "version": "0.2.2",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "main": "src/main.cjs",
  "scripts": {
    "dev": "electron .",
    "build": "node --check src/main.cjs && node --check src/preload.cjs && node --check src/audio-transcription.cjs && node --check src/windows-speech.cjs",
    "lint": "node --check src/main.cjs && node --check src/preload.cjs && node --check src/sidecar.cjs && node --check src/audio-transcription.cjs && node --check src/windows-speech.cjs",
    "format": "prettier --write src",
    "test": "node --test tests/*.test.cjs",
    "package:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest",
    "prettier": "latest"
  },
  "build": {
    "appId": "cn.shadowresume.assistant",
    "productName": "影子简历助手",
    "directories": { "output": "../../output/installers" },
    "files": ["src/**/*", "package.json"],
    "extraResources": [
      { "from": "../../dist/shadow-resume-backend.exe", "to": "backend/shadow-resume-backend.exe" },
      { "from": "../web/dist", "to": "web" }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
